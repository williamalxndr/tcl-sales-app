# Local development only. Copy to .env; keep real secrets out of Git.
DJANGO_SECRET_KEY=local-development-only-change-before-any-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,10.0.2.2
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MYSQL_DATABASE=sales
MYSQL_USER=sales
MYSQL_PASSWORD=local-sales-password
MYSQL_ROOT_PASSWORD=local-root-password
MYSQL_HOST=mysql
MYSQL_PORT=3306
# Host-side port only; MySQL stays on 3306 inside Docker.
MYSQL_PUBLISHED_PORT=3307
API_BIND_HOST=127.0.0.1
API_PORT=8000
